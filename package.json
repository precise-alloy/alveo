{
  "name": "alveo",
  "version": "0.3.0",
  "type": "module",
  "private": false,
  "repository": {
    "url": "https://github.com/precise-alloy/alveo"
  },
  "scripts": {
    "build": "bun check --project tsconfig.json && bun run build:styles",
    "build:styles": "bun src/precompile-styles.ts",
    "prestart": "bun upgrade",
    "typecheck": "bun check --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "bun run typecheck && vitest run --coverage",
    "lint": "eslint --fix",
    "prepublishOnly": "bun run typecheck && bun run test:ci && bun run build",
    "prepare": "git config core.hooksPath .git-hooks"
  },
  "bin": {
    "alveo": "./bin/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "template"
  ],
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "browserslist": "^4.28.8",
    "chalk": "^6.0.0",
    "cheerio": "^1.2.0",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "debounce": "^3.0.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "glob": "^13.0.6",
    "js-beautify": "^2.0.3",
    "js-yaml": "^5.2.3",
    "lightningcss": "^1.33.0",
    "lodash": "^4.17.21",
    "magic-string": "^1.1.0",
    "react-router-dom": "^7.18.2",
    "sass": "^1.102.0",
    "serve-static": "^2.2.0",
    "slash": "^5.1.0",
    "source-map-js": "^1.2.1",
    "vite": "^8.2.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.4",
    "@types/bun": "latest",
    "@types/debounce": "^1.2.4",
    "@types/express": "^5.0.6",
    "@types/js-beautify": "^1.14.3",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/serve-static": "^2.0.1",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.10.0",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.0"
  },
  "license": "MIT"
}